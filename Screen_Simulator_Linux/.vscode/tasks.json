{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-Wall",
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/airspaceParcer.c",
                "${workspaceFolder}/SDCard.c",
                "${workspaceFolder}/Screen/*.c",
                "${workspaceFolder}/Screen/E_Ink/*.c",
                "${workspaceFolder}/Screen/freertos/*.c",
                "${workspaceFolder}/Screen/assets/*.c",
                "${workspaceFolder}/UI_Demo.c",
                "-o",
                "${workspaceFolder}/main",
                "-lm",
                "-lSDL2"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}